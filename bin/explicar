// Código: resaltado + botón copiar
document.querySelectorAll('main pre:not(.mermaid):not(.term)').forEach(p=>{
  const c=p.querySelector('code'); if(c&&window.hljs) hljs.highlightElement(c);
  const b=document.createElement('button'); b.className='copy'; b.textContent='copiar';
  b.onclick=()=>{navigator.clipboard.writeText((c||p).innerText.replace(/copiar\$/,'')); b.textContent='¡copiado!'; setTimeout(()=>b.textContent='copiar',1200)};
  p.append(b);
});
// ===== Animaciones =====
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
// Entrada al hacer scroll, escalonada
// (sin IntersectionObserver: la ventana es pequeña y así nada se queda invisible)
[...document.querySelectorAll('main > *')].forEach((el,i)=>{el.style.animationDelay=Math.min(i,8)*80+'ms';el.classList.add('rv','in')});
// Pasos: botón para reproducir uno a uno
document.querySelectorAll('ol.steps').forEach(ol=>{
  const lis=[...ol.children]; if(lis.length<2) return;
  const b=document.createElement('button'); b.className='play'; b.textContent='▶ Reproducir pasos'; ol.before(b);
  let timer=null;
  b.onclick=()=>{
    clearInterval(timer); let i=0; ol.classList.add('playing'); lis.forEach(l=>l.classList.remove('now','done'));
    const tick=()=>{ if(i>0) {lis[i-1].classList.remove('now');lis[i-1].classList.add('done')}
      if(i>=lis.length){clearInterval(timer);ol.classList.remove('playing');b.textContent='↻ Repetir';return}
      lis[i].classList.add('now'); lis[i].scrollIntoView({block:'nearest',behavior:'smooth'}); i++; };
    b.textContent='⏸ …'; tick(); timer=setInterval(tick,1800);
  };
});
// Terminal que se escribe sola
document.querySelectorAll('pre.term').forEach(p=>{
  const lines=p.textContent.replace(/\s+$/,'').split('\n'); p.textContent='';
  const run=async()=>{
    p.textContent=''; const sleep=ms=>new Promise(r=>setTimeout(r,ms));
    for(const ln of lines){
      const row=document.createElement('div'); p.append(row);
      if(ln.startsWith('$ ')){
        const c=document.createElement('span'); c.className='cmd'; row.append(c);
        const cur=document.createElement('span'); cur.className='cur'; cur.innerHTML='&nbsp;'; row.append(cur);
        for(const ch of ln){c.textContent+=ch; await sleep(reduce?0:35)}
        await sleep(350); cur.remove();
      } else { row.textContent=ln; await sleep(reduce?0:120); }
    }
  };
  const o=new IntersectionObserver(es=>{if(es[0].isIntersecting){o.disconnect();run()}}); o.observe(p);
  const b=document.createElement('button'); b.className='play'; b.textContent='↻ Repetir'; b.onclick=run; p.after(b);
});
// Diagramas: nodos aparecen en orden y las flechas se mueven
function animarDiagrama(el){
  const svg=el.querySelector('svg'); if(!svg||reduce) return;
  svg.classList.add('anim');
  svg.querySelectorAll('.node,.cluster,.mindmap-node,.actor').forEach((n,i)=>n.style.animationDelay=(i*140)+'ms');
  svg.querySelectorAll('.edgeLabel').forEach((n,i)=>n.style.animationDelay=(300+i*140)+'ms');
}
// Mermaid (si un diagrama tiene errores, se muestra su código en vez de romper la página)
(async()=>{
  if(!window.mermaid) return;
  await document.fonts.ready;
  const cs=getComputedStyle(document.documentElement), V=k=>cs.getPropertyValue(k).trim();
  mermaid.initialize({startOnLoad:false,theme:'base',securityLevel:'loose',fontFamily:V('--font'),
    themeVariables:{darkMode:V('--dark')==='1',background:V('--card'),fontSize:'17px',fontFamily:V('--font'),
      primaryColor:V('--node'),primaryBorderColor:V('--acc'),primaryTextColor:V('--fg'),textColor:V('--fg'),
      secondaryColor:V('--card2'),secondaryBorderColor:V('--acc2'),secondaryTextColor:V('--fg'),
      tertiaryColor:V('--card'),tertiaryBorderColor:V('--bd'),tertiaryTextColor:V('--fg'),
      mainBkg:V('--node'),nodeBorder:V('--acc'),nodeTextColor:V('--fg'),lineColor:V('--acc'),
      edgeLabelBackground:V('--card2'),clusterBkg:V('--card2'),clusterBorder:V('--bd'),titleColor:V('--fg'),
      noteBkgColor:V('--card2'),noteTextColor:V('--fg'),noteBorderColor:V('--acc2'),
      actorBkg:V('--node'),actorBorder:V('--acc'),actorTextColor:V('--fg'),actorLineColor:V('--mut'),
      signalColor:V('--fg'),signalTextColor:V('--fg'),labelBoxBkgColor:V('--node'),labelBoxBorderColor:V('--acc'),
      labelTextColor:V('--fg'),loopTextColor:V('--fg'),activationBkgColor:V('--card2'),activationBorderColor:V('--acc'),
      git0:V('--acc'),git1:V('--acc2'),git2:V('--ok'),git3:V('--bad')}});
  // Hace visibles temporalmente las pestañas para que Mermaid pueda medir el texto
  const hidden=[...document.querySelectorAll('.tabs>section:not(.on)')]; hidden.forEach(s=>s.style.display='block');
  let n=0;
  const ancho=el=>el.clientWidth-34;
  const escala=el=>{const v=el.querySelector('svg')?.viewBox?.baseVal; return v&&v.width?ancho(el)/v.width:1};
  for(const el of document.querySelectorAll('pre.mermaid')){
    let src=el.textContent.trim();
    try{
      let {svg}=await mermaid.render('m'+(n++),src); el.innerHTML=svg;
      // Si un diagrama horizontal no cabe y quedaría diminuto, se redibuja en vertical
      if(escala(el)<0.8 && /^(flowchart|graph)\s+(LR|RL)/.test(src)){
        const src2=src.replace(/^(flowchart|graph)\s+(LR|RL)/,'flowchart TD');
        const r2=await mermaid.render('m'+(n++),src2); const viejo=el.innerHTML, e1=escala(el);
        el.innerHTML=r2.svg; if(escala(el)<e1){el.innerHTML=viejo}else{src=src2}
      }
      // Nunca encoger por debajo de ~85%: mejor scroll horizontal que letra ilegible
      const sv=el.querySelector('svg'), v=sv.viewBox.baseVal;
      if(v.width && escala(el)<0.85){ el.classList.add('ancho'); sv.style.width=(v.width*0.9)+'px'; sv.style.height='auto'; }
      animarDiagrama(el);
    }catch(e){ el.classList.add('err'); el.textContent='(no se pudo dibujar este diagrama)\n\n'+src; }
  }
  hidden.forEach(s=>s.style.display='');
  document.querySelectorAll('pre.mermaid:not(.err)').forEach(el=>{
    el.title='Clic para ampliar'; el.onclick=()=>abrirVisor(el.querySelector('svg'));
  });
})();

// Visor a pantalla completa: rueda = zoom, arrastrar = mover, 0 = ajustar
function abrirVisor(svgOrig){
  if(!svgOrig) return;
  const v=svgOrig.viewBox.baseVal, W=v.width||svgOrig.getBBox().width, H=v.height||svgOrig.getBBox().height;
  const z=document.createElement('div'); z.className='zoom';
  z.innerHTML='<div class="barra"><button data-a="menos">−</button><button data-a="ajustar">ajustar</button><button data-a="mas">+</button><button data-a="cerrar">✕</button></div><div class="ayuda">rueda: zoom · arrastrar: mover · 0: ajustar · Esc: cerrar</div><div class="lienzo"></div>';
  const lz=z.querySelector('.lienzo'); const sv=svgOrig.cloneNode(true);
  sv.removeAttribute('style'); sv.setAttribute('width',W); sv.setAttribute('height',H); sv.classList.remove('anim');
  lz.append(sv); document.body.append(z);
  let k=1,x=0,y=0;
  const pintar=()=>{lz.style.transform='translate('+x+'px,'+y+'px) scale('+k+')'};
  const ajustar=()=>{const bw=W+40,bh=H+40; k=Math.min(z.clientWidth*0.94/bw,(z.clientHeight-70)*0.94/bh,3);
    x=(z.clientWidth-bw*k)/2; y=Math.max(50,(z.clientHeight-bh*k)/2); pintar()};
  const zoomEn=(f,cx,cy)=>{const nk=Math.min(8,Math.max(0.2,k*f)); x=cx-(cx-x)*nk/k; y=cy-(cy-y)*nk/k; k=nk; pintar()};
  z.addEventListener('wheel',e=>{e.preventDefault(); zoomEn(e.deltaY<0?1.15:1/1.15,e.clientX,e.clientY)},{passive:false});
  let d=null;
  z.addEventListener('pointerdown',e=>{if(e.target.closest('.barra'))return; d={sx:e.clientX-x,sy:e.clientY-y}; z.classList.add('drag'); z.setPointerCapture(e.pointerId)});
  z.addEventListener('pointermove',e=>{if(d){x=e.clientX-d.sx; y=e.clientY-d.sy; pintar()}});
  z.addEventListener('pointerup',()=>{d=null; z.classList.remove('drag')});
  z.addEventListener('dblclick',e=>zoomEn(1.6,e.clientX,e.clientY));
  const cerrar=()=>{z.remove(); removeEventListener('resize',ajustar); if(document.fullscreenElement) document.exitFullscreen().catch(()=>{})};
  z._cerrar=cerrar;
  z.querySelector('.barra').onclick=e=>{const a=e.target.dataset.a, c=[z.clientWidth/2,z.clientHeight/2];
    if(a==='mas')zoomEn(1.3,...c); if(a==='menos')zoomEn(1/1.3,...c); if(a==='ajustar')ajustar(); if(a==='cerrar')cerrar()};
  addEventListener('resize',ajustar);
  // La ventanita es pequeña: el visor pasa a pantalla completa
  (document.documentElement.requestFullscreen?document.documentElement.requestFullscreen():Promise.reject()).catch(()=>{}).finally(()=>setTimeout(ajustar,120));
  ajustar(); sv.classList.add('anim');
}
addEventListener('keydown',e=>{const z=document.querySelector('.zoom'); if(!z) return;
  if(e.key==='+'||e.key==='=') z.querySelector('[data-a=mas]').click();
  if(e.key==='-') z.querySelector('[data-a=menos]').click();
  if(e.key==='0') z.querySelector('[data-a=ajustar]').click();
});
document.addEventListener('fullscreenchange',()=>{ if(!document.fullscreenElement){const z=document.querySelector('.zoom'); if(z) setTimeout(()=>z.querySelector('[data-a=ajustar]')?.click(),100)} });
addEventListener('keydown',e=>{if(e.key==='Escape'){const z=document.querySelector('.zoom'); z?z._cerrar():window.close()}});
</script>
